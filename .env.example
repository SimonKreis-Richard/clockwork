# Copy this file to .env and fill it in. .env is gitignored and must never be shared.

# --- where the client derived assets live -----------------------------------
#
# Blueprints and data profiles are NOT in this repository. They contain client scenarios,
# usernames and environment URLs, so they live in a workspace directory outside it, which
# also makes this repository reusable across engagements.
#
# Expected layout of that directory:
#   <workspace>/iqp-exports/    raw IQP exports, read only
#   <workspace>/blueprints/     the YAML scenarios, produced by npm run convert
#   <workspace>/data/           data profiles
#   <workspace>/reports/        run journals, summaries and screenshots
#
# Absolute, or relative to the repository root. Unset, everything falls back to the repository
# itself, which is what a checkout with no workspace does.
BLUEPRINT_WORKSPACE=../clockwork-workspace

# --- the target environment -------------------------------------------------

# A DEV or TEST pod. Never production: the engine refuses to start against one.
# Oracle pod hostnames legitimately contain "saasfaprod1" even on a DEV pod, so the guard reads
# the environment token from the first hostname label instead of searching for a substring.
ORACLE_BASE_URL=https://fa-xxxx-dev1-saasfaprod1.fa.ocs.oraclecloud.com/

# --- authentication ---------------------------------------------------------
#
# There is no password here, and nowhere to put one. Run "npm run auth" once, sign in by hand in
# the window that opens, and the session is saved to the file below and reused by every run.
#
# That file holds live session cookies: as sensitive as the password itself. Gitignored, and it
# must never be copied anywhere. When it expires, the engine says so and you run the command again.
# STORAGE_STATE=.auth/storageState.json

# --- how a blocked step behaves ---------------------------------------------

# Assisted mode. On by default: a step that cannot find its element pauses on the failing screen,
# waits for you to do the action, and writes your correction back into the blueprint.
# Set it to false for a run nobody is watching, where a wrong label should simply fail the test.
# ASSIST=false

# Runs are headed by default, because assisted mode needs a window you can act in.
# Set this together with ASSIST=false for an unattended run.
# HEADLESS=true

# How many scenarios run at once. Three to five is realistic for one person supervising. The limit
# is the test data, not the machine: two scenarios creating the same object at the same time
# collide in Oracle, so a parallel batch must be composed of independent scenarios.
# WORKERS=1

# --- optional tuning --------------------------------------------------------

# How long to look for an element before pausing, across every strategy and every frame.
# RESOLVE_TIMEOUT_MS=15000

# List of values timing. Raise these if the type ahead list is slow on your pod.
# LOV_OPTION_TIMEOUT_MS=8000
# LOV_CONFIRM_TIMEOUT_MS=5000
# LOV_TYPE_DELAY_MS=40

# How long to wait, after the opening navigation, before deciding the session has expired.
# SESSION_CHECK_TIMEOUT_MS=1500

# Production guard. Add a token if your test pod uses an unusual naming convention.
# ALLOWED_ENV_TOKENS=dev,test,uat,stage,stg,qa,sandbox
# Deliberate escape hatch for a hostname the guard does not recognise. Think before setting this.
# ALLOW_UNRECOGNISED_HOST=false

# Where journals, screenshots and reports go. Relative to the repository root.
# REPORTS_DIR=reports
